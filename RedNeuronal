# PASO 4: Preparar datos
train_dir = '/content/fer2013_data/train'
test_dir = '/content/fer2013_data/test'

# Categorías de emociones
EMOTIONS = ['angry', 'disgust', 'fear', 'happy', 'neutral', 'sad', 'surprise']
NUM_CLASSES = len(EMOTIONS)

# Parámetros
IMG_SIZE = 48
BATCH_SIZE = 32
EPOCHS = 30

# Aumento de datos
train_datagen = ImageDataGenerator(
    rescale=1./255,
    rotation_range=10,
    width_shift_range=0.1,
    height_shift_range=0.1,
    shear_range=0.1,
    zoom_range=0.1,
    horizontal_flip=True,
    fill_mode='nearest'
)

test_datagen = ImageDataGenerator(rescale=1./255)

# Cargar imágenes
train_generator = train_datagen.flow_from_directory(
    train_dir,
    target_size=(IMG_SIZE, IMG_SIZE),
    batch_size=BATCH_SIZE,
    color_mode='grayscale',
    class_mode='categorical'
)

test_generator = test_datagen.flow_from_directory(
    test_dir,
    target_size=(IMG_SIZE, IMG_SIZE),
    batch_size=BATCH_SIZE,
    color_mode='grayscale',
    class_mode='categorical'
)

print(f"Clases encontradas: {train_generator.class_indices}")

# PASO 5: Crear modelo CNN
def create_emotion_model():
    model = models.Sequential([
        # Bloque 1
        layers.Conv2D(32, (3, 3), activation='relu',
                     input_shape=(IMG_SIZE, IMG_SIZE, 1)),
        layers.BatchNormalization(),
        layers.Conv2D(64, (3, 3), activation='relu'),
        layers.BatchNormalization(),
        layers.MaxPooling2D((2, 2)) # Missing closing bracket for the list of layers
    ]) # Added the missing closing bracket
